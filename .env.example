# ─── CORE INFRASTRUCTURE (Dockerized) ───────────────────────

# PostgreSQL (Internal)
POSTGRES_USER=alzai
POSTGRES_PASSWORD=alzai_secure_password
POSTGRES_DB=alzai

# PgBouncer (Use this for backend connections)
POSTGRES_URL=postgresql://alzai:alzai_secure_password@pgbouncer:6432/alzai

# Neo4j (Local)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=alzai_secure_password

# Redis (Local)
REDIS_URL=redis://redis:6379/0

# ─── STORAGE LAYER (MinIO Local S3) ──────────────────────────
# Replace Cloudinary in Phase 9
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio_admin_secure
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=alzai-media

# ─── AI & LLM (Host Machine) ───────────────────────────────
# Backend in Docker reaches Host Ollama via this URL:
OLLAMA_API_BASE=http://host.docker.internal:11434
OLLAMA_MODEL=phi3

# ─── JWT AUTH ─────────────────────────────────────────────
JWT_SECRET_KEY=generate_a_secure_random_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ─── EXTERNAL SERVICES (Phase 2-7) ─────────────────────────
# Groq (Fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Twilio (Alerts)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── FRONTEND & MOBILE ────────────────────────────────────
VITE_API_BASE_URL=http://localhost
VITE_WS_URL=ws://localhost/api/saathi/ws

# Flutter
API_BASE_URL=http://10.0.2.2  # Android Emulator access to Host
WS_BASE_URL=ws://10.0.2.2/api/saathi/ws
