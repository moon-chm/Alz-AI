# ─── CORE INFRASTRUCTURE (Dockerized) ───────────────────────
# These variables are required for docker-compose to start services correctly.

# PostgreSQL
POSTGRES_USER=alzai
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=alzai

# DATABASE_URL for Alembic & Application Logic
# Format: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_URL=postgresql://alzai:replace_with_secure_password@db:5432/alzai
POSTGRES_URL=postgresql://alzai:replace_with_secure_password@db:5432/alzai

# Neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_secure_password
NEO4J_URI=bolt://neo4j:7687

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=replace_with_secure_password

# ─── STORAGE LAYER (MinIO) ──────────────────────────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=replace_with_secure_password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=alzai-media

# ─── AI & LLM ──────────────────────────────────────────────
OLLAMA_API_BASE=http://host.docker.internal:11434
OLLAMA_MODEL=phi3

# ─── AUTH & SECURITY ───────────────────────────────────────
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=your_secure_hex_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ─── EXTERNAL SERVICES ─────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── NETWORK CONFIG (Public Access) ───────────────────────
# For Mobile, use --dart-define=API_BASE_URL=... during build
API_BASE_URL=http://localhost/api
WS_BASE_URL=ws://localhost/ws
